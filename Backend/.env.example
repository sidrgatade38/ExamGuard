# ExamGuard Backend Environment Variables (Production & Development)
# IMPORTANT: Never commit real production secrets, credentials, or private keys to version control.

# Application Environment (development | test | production)
NODE_ENV=development

# Server Port
PORT=5000

# Supabase PostgreSQL & Storage Configuration
# In production, SUPABASE_URL must use https:// and keys must be securely provisioned.
SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_ANON_KEY=your_supabase_anon_public_key
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_private_key

# Custom JWT Authentication Configuration
# In production, JWT_SECRET must be at least 32 cryptographically random characters.
# Placeholders (e.g. 'examguard_secure_jwt_secret_dev_key_2026_examguard') are strictly rejected in production.
JWT_SECRET=replace_with_at_least_32_random_bytes_hex_or_base64
JWT_EXPIRES_IN=1h

# Supabase Storage Configuration
STORAGE_BUCKET=examguard-storage
MAX_QUESTION_PAPER_SIZE_MB=10

# Production CORS & Origin Allowlist
# Comma-separated list of permitted frontend origins. Wildcard (*) is strictly forbidden in production.
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Reverse Proxy Trust Configuration
# Set to 'true' or '1' when deployed behind Nginx, AWS ALB, Cloudflare, or Traefik to ensure correct IP rate-limiting.
TRUST_PROXY=false

# Authentication Rate Limiting Configuration (POST /api/auth/login)
LOGIN_RATE_LIMIT_WINDOW_MINUTES=15
LOGIN_RATE_LIMIT_MAX_ATTEMPTS=10

# Cryptographic Key Paths (Relative to Backend root or Absolute Paths)
# RSA Key-Wrapping (RSA-OAEP-SHA256, 2048+ bit)
QUESTION_PAPER_KEY_WRAPPING_PUBLIC_KEY_PATH=keys/question-paper-key-wrapping-public.pem
QUESTION_PAPER_KEY_WRAPPING_PRIVATE_KEY_PATH=keys/question-paper-key-wrapping-private.pem

# RSA Encryption / Compatibility Aliases
QUESTION_PAPER_ENCRYPTION_PUBLIC_KEY_PATH=keys/question-paper-encryption-public.pem
QUESTION_PAPER_ENCRYPTION_PRIVATE_KEY_PATH=keys/question-paper-encryption-private.pem

# RSA Digital Signatures (RSA-PSS-SHA256, 2048+ bit)
QUESTION_PAPER_SIGNING_PUBLIC_KEY_PATH=keys/question-paper-signing-public.pem
QUESTION_PAPER_SIGNING_PRIVATE_KEY_PATH=keys/question-paper-signing-private.pem

# Cloud Deployment Key Provisioning (Render / Railway / AWS / Docker)
# If filesystem mounts are not available, keys can be passed as Base64-encoded environment variables:
# Run "node scripts/exportKeysForRender.js" locally to generate these from existing keys:
# QUESTION_PAPER_KEY_WRAPPING_PUBLIC_KEY_BASE64=
# QUESTION_PAPER_KEY_WRAPPING_PRIVATE_KEY_BASE64=
# QUESTION_PAPER_SIGNING_PUBLIC_KEY_BASE64=
# QUESTION_PAPER_SIGNING_PRIVATE_KEY_BASE64=



