# ==============================================================================
# ExamGuard - Git Ignore Policy
# ==============================================================================

# Dependencies
node_modules/
.pnp
.pnp.js

# Environment Variables & Secrets (CRITICAL SECURITY)
.env
.env.*
!.env.example
!.env.*.example
*.env
*.env.local
*.env.*.local

# Cryptographic Keys, Certificates & Dump Files (CRITICAL SECURITY)
Backend/keys/*.pem
keys/*.pem
*.pem
*.key
*.crt
*.cer
*.pfx
*.p12
*.dump
!Backend/keys/.gitkeep

# Build and Distribution Outputs
dist/
dist-ssr/
build/
out/
*.local

# Test & Coverage Artifacts
coverage/
*.lcov
.nyc_output/

# Logs and Debug Output
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*
*.log

# Temporary and Cache Directories
.cache/
.parcel-cache/
.eslintcache
tmp/
temp/
*.tmp
*.temp
scratch/

# Operating System Files
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
desktop.ini

# Editor & IDE Directories
.vscode/
!.vscode/extensions.json
!.vscode/settings.json
.idea/
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?
